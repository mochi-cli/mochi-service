# Copy to .env.local and fill in. Never commit the filled-in copy.
# In production every one of these is a Vercel environment variable.

# Public origin of this service. Google's redirect URI and Stripe's return
# URLs are built from it, so it has to match what is registered with both.
SERVICE_ORIGIN=https://account.example.com

# Neon (Vercel Marketplace). The pooled connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Upstash Redis (Vercel Marketplace). Sign-in codes live here for ten minutes.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Google OAuth client, scope `openid email` only — see src/lib/google.ts for
# why the narrow scope is load-bearing rather than tidiness.
# Authorised redirect URI: $SERVICE_ORIGIN/auth/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Stripe. The webhook secret comes from the endpoint you register at
# $SERVICE_ORIGIN/webhooks/stripe, not from the API keys page.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me

# Which key signs the entitlement claim. Ships in the desktop build's key map,
# so changing it is how a compromised key gets retired.
CLAIM_KID=2026-09

# Production: Cloud KMS. The private key is generated there and never leaves,
# so there is no environment variable holding it. Note this names a key
# *version* — asymmetricSign will not accept the key itself.
#   projects/P/locations/global/keyRings/R/cryptoKeys/K/cryptoKeyVersions/1
CLAIM_KMS_KEY=

# The service account that may call asymmetricSign on that one key, as the
# whole downloaded JSON on a single line. Needed because Vercel has no metadata
# server for the Google libraries to ask. Leave empty locally, where `gcloud
# auth application-default login` covers it.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local development only. Refused when NODE_ENV or VERCEL_ENV is production —
# a signing key in an environment variable is one crash dump away from minting
# Pro forever. Generate one with:
#   openssl genpkey -algorithm ed25519
CLAIM_SIGNING_KEY=

# How long a claim is believed. Days, not hours: this doubles as the offline
# grace period, so a short value turns a brief outage into a support queue.
CLAIM_LIFETIME_DAYS=7
